VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Public browser key restricted to this site's HTTP referrers and Maps JavaScript API.
# Never reuse the server GOOGLE_MAPS_API_KEY here.
VITE_GOOGLE_MAPS_BROWSER_KEY=

# Compatibilidad temporal con proyectos que aun usan la clave anon legacy.
VITE_SUPABASE_ANON_KEY=

# Local development only. Never configure this in Vercel production.
VITE_DEV_AUTH_TOKEN=impulsa-local-dev
VITE_DEV_BUSINESS_ID=1
VITE_DEV_BRANCH_ID=1
